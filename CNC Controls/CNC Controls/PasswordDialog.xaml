<Window x:Class="CNC.Controls.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Xác thực truy cập - LAK-CNC" Height="330" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F5F6F8" WindowStyle="SingleBorderWindow"
        Loaded="Window_Loaded" Icon="App.ico">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- Header Banner -->
        <Border Grid.Row="0" Background="#1E293B" Padding="20,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="42" Height="42" Background="#2563EB" CornerRadius="21" Margin="0,0,15,0">
                    <TextBlock Text="🔒" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="txtHeaderTitle" Text="XÁC THỰC BẢN QUYỀN" Foreground="White" FontSize="15" FontWeight="Bold" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="txtHeaderSub" Text="Vui lòng nhập mật khẩu để khởi chạy ứng dụng" Foreground="#94A3B8" FontSize="11" Margin="0,3,0,0" FontFamily="Segoe UI"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Body Form -->
        <StackPanel Grid.Row="1" Margin="25,18,25,0">
            <TextBlock Text="Mật khẩu truy cập:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" FontFamily="Segoe UI"/>
            
            <Grid Margin="0,8,0,0">
                <PasswordBox x:Name="txtPassword" Height="36" FontSize="14" Padding="8,4,36,4"
                             VerticalContentAlignment="Center" Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                             KeyDown="TxtPassword_KeyDown" PasswordChanged="TxtPassword_PasswordChanged"/>
                
                <TextBox x:Name="txtPasswordVisible" Height="36" FontSize="14" Padding="8,4,36,4"
                         VerticalContentAlignment="Center" Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                         Visibility="Collapsed" KeyDown="TxtPasswordVisible_KeyDown" TextChanged="TxtPasswordVisible_TextChanged"/>
                
                <Button x:Name="btnToggleEye" Content="👁️" Width="30" Height="30" HorizontalAlignment="Right"
                        Margin="0,0,3,0" Background="Transparent" BorderThickness="0"
                        Click="BtnToggleEye_Click" ToolTip="Hiện/Ẩn mật khẩu" Focusable="False"/>
            </Grid>

            <!-- Error Message -->
            <TextBlock x:Name="txtError" Text="" Foreground="#DC2626" FontSize="12" Margin="0,6,0,0"
                       FontFamily="Segoe UI" FontWeight="Medium" Visibility="Collapsed"/>

            <!-- Remember Me Option -->
            <CheckBox x:Name="chkRemember" Content="Ghi nhớ mật khẩu trên máy tính này" Margin="0,12,0,0"
                      FontSize="12.5" Foreground="#475569" FontFamily="Segoe UI" IsChecked="True" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="20,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnExit" Content="Thoát" Width="90" Height="34" Margin="0,0,10,0"
                        Background="#F1F5F9" Foreground="#475569" BorderBrush="#94A3B8" BorderThickness="1"
                        Click="BtnExit_Click" IsCancel="True"/>
                
                <Button x:Name="btnSubmit" Content="Mở khóa" Width="105" Height="34"
                        Background="#2563EB" Foreground="White" BorderThickness="0"
                        Click="BtnSubmit_Click" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
